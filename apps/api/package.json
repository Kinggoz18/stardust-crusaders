{
  "name": "@stardust/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test src",
    "test:integration": "bun test --preload ./test/setup.ts test/integration",
    "lint": "echo 'api lint ok'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:migrate:check": "bun run src/db/migrate-check.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@stardust/schema": "workspace:*",
    "drizzle-orm": "^0.40.0",
    "fastify": "^5.2.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.2",
    "otpauth": "^9.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.4",
    "embedded-postgres": "^17.6.0-beta.15",
    "typescript": "^5.8.2"
  }
}
